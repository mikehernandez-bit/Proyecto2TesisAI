{
  "name": "gicagen-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "E2E scaffold for GicaGen wizard flows",
  "scripts": {
    "css:build": "tailwindcss -c tailwind.config.cjs -i ./app/static/CSS/tailwind.input.css -o ./app/static/CSS/tailwind.generated.css --minify",
    "css:watch": "tailwindcss -c tailwind.config.cjs -i ./app/static/CSS/tailwind.input.css -o ./app/static/CSS/tailwind.generated.css --watch",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^25.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
